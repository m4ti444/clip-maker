# Proveedor de LLM: 'gemini', 'openai', o 'ollama'
LLM_PROVIDER=gemini

# API Key (Gemini o OpenAI)
LLM_API_KEY=

# Modelo del LLM
LLM_MODEL=gemini-2.0-flash

# Modelo de Whisper: tiny, base, small, medium, large
WHISPER_MODEL=base

# URL de Ollama (solo si usas Ollama)
OLLAMA_URL=http://localhost:11434

# Directorios
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output

# Configuración de clips por defecto
DEFAULT_CLIP_MIN_DURATION=30
DEFAULT_CLIP_MAX_DURATION=60
DEFAULT_CLIP_COUNT=5
